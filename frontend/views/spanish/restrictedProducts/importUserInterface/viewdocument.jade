extends ../../../templates/users/default

block content

  section.environmentUsers

    div.background_product_color

    div.margin_content_document
      div.info_product
        div.top_info
          h3.nombre= restricted_product.nombre

          if restricted_product.subpartida
            h3.partida= 'PA: ' + restricted_product.subpartida
          
          if restricted_product.files && restricted_product.files.length
            div.documents-container
              each file in restricted_product.files
                if file
                  - var isPDF = /\.pdf(?:$|[?#])/i.test(file)

                  div.img_document
                    a(href=file target="_blank" rel="noopener noreferrer")
                      if isPDF
                        img.img_produce(
                          src="/images/icons/pdf.png"
                          alt="Documento PDF"
                          title="Abrir PDF"
                        )
                      else
                        img.img_produce(
                          src=file
                          alt="Imagen del documento"
                        )

          if restricted_product.iam == "Sin restricción"

            div.contacts

              div.whatsapp()

                div.wtp_btn(style='background-image: url("/images/restrictedProducts/0.jpg");')

                a(href="https://wa.me/51946122872" target="_blank")
                  button(class="btn_wtp") Contactar a Aeropost

      div.general_info
        div.necessary_documents
          div.whole_content_1
            div.sub_content
              div.text_docu
                h3.needs ¿Qué trámite necesita?

                h3.entidad= restricted_product.entidad

                h3.documents_prod= restricted_product.documents

                div.img_docu

                if restricted_product.tupa_permiso && restricted_product.precio_permiso

                  div.precio_permiso

                    p.focus A tener en cuenta:
                    p.permiso= 'Tramitar TUPA: ' + restricted_product.tupa_permiso
                    p.precio= 'Precio: ' + restricted_product.precio_permiso

                div.target_docu

                  p Documentación de apoyo

                  if restricted_product.entidad == "PRODUCE"

                    if restricted_product.documents == "Certificado sanitario expedido por la autoridad competente del país de origen"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=6" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/produce/produce_.PNG" title="VUCE - PRODUCE")

                    if restricted_product.documents == "Certificado de Procedencia del Ministerio de Pesquería o Direcciones Regionales"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=4" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/produce/produce_sanipes.PNG" title="VUCE - SANIPES")

                    if restricted_product.documents == "Permiso de Importación de OTO / PERU"

                      div.img_document

                        a(href="http://otoperu-news.blogspot.com/p/permiso-de-importacion-de-saos.html" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/produce/oto.PNG" title="OTO / PERU")

                    if restricted_product.documents == "Certificado de Conformidad, Constancia de Cumplimiento"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=6" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/produce/produce_.PNG" title="VUCE - PRODUCE")

                    if restricted_product.documents == "DGAAI-PRODUCE (SAO)"

                      div.img_document

                        a(href="http://otoperu-news.blogspot.com/p/permiso-de-importacion-de-saos.html" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/produce/oto.PNG" title="OTO / PERU")

                  if restricted_product.entidad == "MINAGRI"

                    if restricted_product.documents == "Permiso fitosanitario de Importación del SENASA"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=3" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minagri/senasa/minagri_senasa.PNG" title="VUCE - SENASA")

                    if restricted_product.documents == "Permiso zoosanitario de Importación del SENASA"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=3" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minagri/senasa/minagri_senasa.PNG" title="VUCE - SENASA")

                    if restricted_product.documents == "Certificado de Internamiento de SENASA"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=3" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minagri/senasa/minagri_senasa.PNG" title="VUCE - SENASA")

                    if restricted_product.documents == "Certificado de análisis SENASA"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=3" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minagri/senasa/minagri_senasa.PNG" title="VUCE - SENASA")

                    if restricted_product.documents == "Certificado fito o zoosanitario del país de origen SENASA"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=3" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minagri/senasa/minagri_senasa.PNG" title="VUCE - SENASA")

                    if restricted_product.documents == "Permiso de SENASA"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=3" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minagri/senasa/minagri_senasa.PNG" title="VUCE - SENASA")

                  if restricted_product.entidad == "MININTER"

                    if restricted_product.documents == "Permiso emitido por SUCAMEC"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=37" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/mininter/mininter_sucamec.PNG" title="VUCE - SUCAMEC")

                    if restricted_product.documents == "Autorización de importación de productos pirotécnicos y materiales relacionados"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=37" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/mininter/mininter_sucamec.PNG" title="VUCE - SUCAMEC")

                  if restricted_product.entidad == "MRREE"

                    if restricted_product.documents == "Resolución Directoral emitida por el MRREE"

                      div.img_document

                        a(href="http://transparencia.rree.gob.pe/index.php/datos-generales-11/13-normas-emitidas-por-la-entidad/1-3-5-resoluciones-directorales-rd/ano-2017-22/enero-5" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/mrree/mrree.PNG" title="MRREE")

                  if restricted_product.entidad == "MINSA"

                    if restricted_product.documents == "Permiso emitido por DIGEMID"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=3" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minsa/digemid/digemid.PNG" title="VUCE")

                      div.img_document

                        a(href="http://www.digemid.minsa.gob.pe/Main.asp?Seccion=872" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minsa/digemid/web.PNG" title="Instructivo")

                      div.img_document

                        a(href="/images/ministerios/minsa/digemid/modeloreceta.pdf" download="Modeloreceta" target="_blank")
                          img.img_produce(src="/images/ministerios/minsa/digemid/modeloreceta_img.PNG" title="Modelo de Receta Médica")

                    if restricted_product.documents == "DIGEMID - Necesita registro y/o receta médica visada"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=3" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minsa/digemid/digemid.PNG" title="VUCE")

                      div.img_document

                        a(href="http://www.digemid.minsa.gob.pe/Main.asp?Seccion=872" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minsa/digemid/web.PNG" title="Instructivo")

                      div.img_document

                        a(href="/images/ministerios/minsa/digemid/modeloreceta.pdf" download="Modeloreceta" target="_blank")
                          img.img_produce(src="/images/ministerios/minsa/digemid/modeloreceta_img.PNG" title="Modelo de Receta Médica")

                    if restricted_product.documents == "Permiso emitido por DIGESA"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=1" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minsa/digesa/digesa.PNG" title="VUCE")

                      div.img_document

                        a(href="/images/ministerios/minsa/digesa/DGS014_Autorizacion_Sanitaria_para_importacion_Juguetes_yo_Utiles_Escritorio.pdf" download="Instructivo_digesa" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/minsa/digesa/instructivo_digesa.PNG" title="Intructivo")

                  if restricted_product.entidad == "MTC"

                    if restricted_product.documents == "Permiso de Internamiento"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=2" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/mtc/mtc.PNG" title="VUCE - MTC")

                    if restricted_product.documents == "Requiere ser homologado"

                      div.img_document

                        a(href="https://www.vuce.gob.pe/vuce/fmt.htm?method=cargarFormatosPorEntidad&entidad=2" target="_blank")
                          img.img_produce(src="/images/restrictedProducts/ministerios/mtc/mtc.PNG" title="VUCE - MTC")

                  if restricted_product.url_tramite

                    a(href="#{restricted_product.url_tramite}" target="_blank")
                      button.btn_minin Iniciar trámite

              if restricted_product.comentario

                div.add_msg

                  p Comentario adicional
                  h3= restricted_product.comentario

          div.whole_content_2

           div.sub_content

              div.whatsapp(style='background-image: url("/images/restrictedProducts/0.jpg");')

              p.title ¿Desea más información?
              p.s_text Contacte a un asesor de OSOMA

               div.wtp_btn

                a(href="https://wa.me/51975713770" target="_blank")
                 button.btn_wtp Enviar WhatsApp

              if restricted_product.aeropost_link

               div.aeropost_btn

                 div(style="background:#8fc7e8; width: 100%;border-radius:5px;")

                  div.aeropost-btn(style="text-align:center")

                    a(href="#{restricted_product.aeropost_link}" target="_blank" style="text-decoration: none;")

                     img(src="/images/restrictedProducts/aero.jpg" style="width:95px; vertical-align:0px;")

                    a(href="#{restricted_product.aeropost_link}" target="_blank" style="text-decoration: none;")

                     button(style="background: white; display:block; border-radius:5px; padding:8px;border:0px; color:#002d93;text-decoration: none; width: 100%;") Ver productos

        if restricted_product.comentario

          if restricted_product.iam == "Prohibido"

            div.comment_prohibido

              p Comentario adicional
              h3= restricted_product.comentario

          if restricted_product.iam == "Restringido"

          if restricted_product.iam == "Sin restricción"

            div.comment

              p Comentario adicional
              h3= restricted_product.comentario

      div.font

        p.text_font Fuente de información,
        a(href="#{restricted_product.link}" target="_blank") aquí

  //script(src="/javascripts/aeropost/jsTest.js")
  script(src="/javascripts/index/restrictedProducts/searchEngine.js")